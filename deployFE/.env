FRONTEND_IMAGE=nginx:1.30-alpine
FRONTEND_CONTAINER_NAME=qtm-frontend-example
FRONTEND_NETWORK=qtm-net
FRONTEND_DOMAIN=app.qtmdev.quicare.com
FRONTEND_PATH_PREFIX=/keycloak-test
FRONTEND_TRAEFIK_RULE=Host(`app.qtmdev.quicare.com`) && PathPrefix(`/keycloak-test`)

FRONTEND_APP_PATH=./app
FRONTEND_CONF=./nginx.conf