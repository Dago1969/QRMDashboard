<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.8.xsd">

    <changeSet id="20260429-04-create-user-role-profile-table" author="copilot">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="user_role_profile"/>
            </not>
        </preConditions>

        <createTable tableName="user_role_profile">
            <column name="user_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="tenant_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="role_id" type="VARCHAR(100)">
                <constraints nullable="false"/>
            </column>
            <column name="profile_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <addPrimaryKey
                tableName="user_role_profile"
                columnNames="user_id, tenant_id, role_id, profile_id"
                constraintName="pk_user_role_profile"/>

        <addForeignKeyConstraint
                baseTableName="user_role_profile"
                baseColumnNames="user_id"
                constraintName="fk_user_role_profile_user"
                referencedTableName="users"
                referencedColumnNames="id"/>

        <addForeignKeyConstraint
                baseTableName="user_role_profile"
                baseColumnNames="tenant_id"
                constraintName="fk_user_role_profile_tenant"
                referencedTableName="tenant_app_pointer"
                referencedColumnNames="id"/>

        <addForeignKeyConstraint
                baseTableName="user_role_profile"
                baseColumnNames="role_id"
                constraintName="fk_user_role_profile_role"
                referencedTableName="roles"
                referencedColumnNames="id"/>

        <addForeignKeyConstraint
            baseTableName="user_role_profile"
            baseColumnNames="profile_id"
            constraintName="fk_user_role_profile_profile"
            referencedTableName="projects"
            referencedColumnNames="id"/>
    </changeSet>

</databaseChangeLog>