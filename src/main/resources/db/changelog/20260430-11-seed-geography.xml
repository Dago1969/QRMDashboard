<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.8.xsd">

    <!-- Seed geografico ricostruito dai caricamenti legacy archiviati in old. -->
    <changeSet id="20260430-11-seed-country" author="copilot">
        <preConditions onFail="MARK_RAN">
            <tableExists tableName="country"/>
        </preConditions>
        <loadUpdateData tableName="country" primaryKey="id" file="data/country.csv" relativeToChangelogFile="true" separator="," encoding="UTF-8">
            <column name="id"/>
            <column name="sigla_nazione"/>
            <column name="codice_belfiore"/>
            <column name="name"/>
            <column name="denominazione_cittadinanza"/>
        </loadUpdateData>
    </changeSet>

    <changeSet id="20260430-11-seed-region" author="copilot">
        <preConditions onFail="MARK_RAN">
            <tableExists tableName="region"/>
        </preConditions>
        <loadUpdateData tableName="region" primaryKey="id" file="data/region.csv" relativeToChangelogFile="true" separator="," encoding="UTF-8">
            <column name="id"/>
            <column name="country_id"/>
            <column name="ripartizione_geografica"/>
            <column name="codice_regione"/>
            <column name="name"/>
            <column name="tipologia_regione"/>
            <column name="numero_province"/>
            <column name="numero_comuni"/>
            <column name="superficie_kmq"/>
        </loadUpdateData>
    </changeSet>

    <changeSet id="20260430-11-seed-province" author="copilot">
        <preConditions onFail="MARK_RAN">
            <tableExists tableName="province"/>
        </preConditions>
        <loadUpdateData tableName="province" primaryKey="id" file="data/province.csv" relativeToChangelogFile="true" separator="," encoding="UTF-8">
            <column name="id"/>
            <column name="region_id"/>
            <column name="sigla_provincia"/>
            <column name="name"/>
            <column name="tipologia_provincia"/>
            <column name="numero_comuni"/>
            <column name="superficie_kmq"/>
            <column name="codice_sovracomunale"/>
        </loadUpdateData>
    </changeSet>

    <changeSet id="20260430-11-seed-city" author="copilot">
        <preConditions onFail="MARK_RAN">
            <tableExists tableName="city"/>
        </preConditions>
        <loadUpdateData tableName="city" primaryKey="id" file="data/city.csv" relativeToChangelogFile="true" separator="," encoding="UTF-8">
            <column name="id"/>
            <column name="province_id"/>
            <column name="codice_istat"/>
            <column name="denominazione_ita_altra"/>
            <column name="name"/>
            <column name="cap"/>
            <column name="denominazione_altra"/>
            <column name="flag_capoluogo"/>
            <column name="codice_belfiore"/>
            <column name="lat"/>
            <column name="lon"/>
            <column name="superficie_kmq"/>
            <column name="codice_sovracomunale"/>
        </loadUpdateData>
    </changeSet>

</databaseChangeLog>