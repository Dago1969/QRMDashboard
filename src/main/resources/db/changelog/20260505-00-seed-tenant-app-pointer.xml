<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.8.xsd">

    <!-- Seed idempotente tenant_app_pointer: inserisce solo se non esiste -->
    <changeSet id="20260505-00-seed-tenant-app-pointer-A" author="copilot">
        <preConditions onFail="MARK_RAN">
            <not>
                <sqlCheck expectedResult="0">
                    SELECT COUNT(*) FROM tenant_app_pointer WHERE id = 1
                </sqlCheck>
            </not>
        </preConditions>
        <insert tableName="tenant_app_pointer">
            <column name="id" valueNumeric="1"/>
            <column name="client_code" value="app-cliente-A"/>
            <column name="client_name" value="app-cliente-A"/>
            <column name="tenant_app_url" value="http://localhost:4201/dashboard"/>
            <column name="enabled" valueBoolean="true"/>
        </insert>
    </changeSet>
    <changeSet id="20260505-00-seed-tenant-app-pointer-B" author="copilot">
        <preConditions onFail="MARK_RAN">
            <not>
                <sqlCheck expectedResult="0">
                    SELECT COUNT(*) FROM tenant_app_pointer WHERE id = 2
                </sqlCheck>
            </not>
        </preConditions>
        <insert tableName="tenant_app_pointer">
            <column name="id" valueNumeric="2"/>
            <column name="client_code" value="app-cliente-B"/>
            <column name="client_name" value="app-cliente-B"/>
            <column name="tenant_app_url" value="http://localhost:4201/dashboard"/>
            <column name="enabled" valueBoolean="true"/>
        </insert>
    </changeSet>
</databaseChangeLog>
