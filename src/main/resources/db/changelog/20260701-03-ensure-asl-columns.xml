<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.8.xsd">

    <changeSet id="20260701-03-add-asl-codice-azienda" author="copilot">
        <preConditions onFail="MARK_RAN" onError="HALT">
            <and>
                <tableExists tableName="asl"/>
                <not>
                    <columnExists tableName="asl" columnName="codice_azienda"/>
                </not>
            </and>
        </preConditions>
        <addColumn tableName="asl">
            <column name="codice_azienda" type="VARCHAR(50)"/>
        </addColumn>
    </changeSet>

    <changeSet id="20260701-03-add-asl-denominazione-azienda" author="copilot">
        <preConditions onFail="MARK_RAN" onError="HALT">
            <and>
                <tableExists tableName="asl"/>
                <not>
                    <columnExists tableName="asl" columnName="denominazione_azienda"/>
                </not>
            </and>
        </preConditions>
        <addColumn tableName="asl">
            <column name="denominazione_azienda" type="VARCHAR(500)"/>
        </addColumn>
    </changeSet>

    <changeSet id="20260701-03-add-asl-codice-regione" author="copilot">
        <preConditions onFail="MARK_RAN" onError="HALT">
            <and>
                <tableExists tableName="asl"/>
                <not>
                    <columnExists tableName="asl" columnName="codice_regione"/>
                </not>
            </and>
        </preConditions>
        <addColumn tableName="asl">
            <column name="codice_regione" type="VARCHAR(10)"/>
        </addColumn>
    </changeSet>

</databaseChangeLog>