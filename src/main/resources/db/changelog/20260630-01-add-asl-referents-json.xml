<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.8.xsd">

    <changeSet id="20260630-01-add-asl-referents-json" author="copilot">
        <preConditions onFail="MARK_RAN" onError="HALT">
            <and>
                <tableExists tableName="asl"/>
                <not>
                    <columnExists tableName="asl" columnName="referents_json"/>
                </not>
            </and>
        </preConditions>
        <addColumn tableName="asl">
            <column name="referents_json" type="VARCHAR(8000)"/>
        </addColumn>
    </changeSet>
</databaseChangeLog>